# Copy this file to .env and fill in YOUR values privately.
# Do not paste your password into chat, Git, or screenshots.

PORT=5000
NODE_ENV=development

# Local PostgreSQL. Replace YOUR_PASSWORD with the postgres user password.
# If the password contains @, #, /, or other special characters, URL-encode them.
# Example shape only — never commit a real password:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/miniledger_db

# Isolated database used by Jest. Never point this at miniledger_db.
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/miniledger_test

# Use a long random string in your private .env (at least 16 characters).
JWT_SECRET=change_me_to_a_long_random_secret

# Development mock authentication. OTPs are printed in the backend terminal
# only when this is true. This is NOT production SMS authentication.
MOCK_OTP_ENABLED=true

# Optional receipt uploads (local disk demo)
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
JWT_EXPIRES_IN=7d
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
